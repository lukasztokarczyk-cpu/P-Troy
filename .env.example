# --- Baza danych ---
DATABASE_URL="postgresql://erp:erp_password@localhost:5432/erp_elektryk?schema=public"

# --- JWT ---
JWT_ACCESS_SECRET="zmien-na-losowy-64-znakowy-sekret"
JWT_REFRESH_SECRET="zmien-na-inny-losowy-64-znakowy-sekret"

# --- Frontend / CORS ---
FRONTEND_URL="http://localhost:3000"

# --- Przechowywanie plików ---
# Ten hosting (shared, bez roota/Dockera) nie pozwala uruchomić własnego
# serwera MinIO jako trwałej usługi w tle, więc backendem magazynu jest
# lokalny system plików serwera (patrz FileStorageService). Interfejs
# jest identyczny jak dla MinIO/S3 — po ewentualnej migracji na własny
# serwer wystarczy podmienić implementację, żadne inne moduły się nie zmieniają.
STORAGE_LOCAL_PATH="./storage"
# Sekret do podpisywania tymczasowych linków do plików (odpowiednik
# presigned URL z S3) — jeśli puste, użyty zostanie JWT_ACCESS_SECRET.
FILE_SIGNING_SECRET=""
# Opcjonalne — jeśli backend i frontend są kiedyś na różnych domenach.
# Domyślnie używane jest FRONTEND_URL (poprawne, gdy obie części
# aplikacji są pod tą samą domeną, tak jak w obecnym wdrożeniu).
API_PUBLIC_URL=""

# --- SMTP (nadpisywalne w panelu Ustawienia) ---
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="ERP Elektryk <no-reply@erp-elektryk.local>"

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_CONTACT_EMAIL="admin@erp-elektryk.local"

# --- Seed ---
SEED_ADMIN_PASSWORD="ZmienToHaslo123!"

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="http://localhost:4000"
